# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Logs y datos locales
logs/*.log
logs/
data/*.json
data/*.corrupt*
# Indice semantico: lo DERIVA el propio Jarvis de las memorias, y esas
# (data/*.json) ya estan ignoradas aqui arriba. Versionar el derivado
# mientras se ignora su fuente no tiene sentido: ademas cambia en cada
# uso, asi que ensuciaba `git status` de forma permanente. Si falta, se
# reconstruye solo (SemanticIndex._load sale vacio y sync() lo rehace).
data/*.npz

# Cachés generados (reproducibles, no se versionan)
hud_pro/gpu/_cache/

# Entorno virtual
venv/
.venv/
jarvis_venv/


# IDE
.vscode/
.idea/
.claude/

# OS
Thumbs.db
.DS_Store

# Archivos temporales de voz/audio
*.wav
*.mp3
# ...salvo los fixtures de prueba (audio sintético, versionado a propósito)
!test/fixtures/*.wav

# Lock files
*.lock

# Salidas crudas del banco de pruebas (la línea base va en docs/)
scripts/_out/

# Secretos y credenciales (NUNCA subir)
secrets.yaml
credentials.json
token.json
data/.spotify_cache
data/.spotify_cache.bak

# Estado interno de herramientas de Claude Code (no es parte del proyecto)
managed_context/
test_suite_analysis/
scratch_preview/
reminders.json.test

# cobertura
.coverage
htmlcov/

# Modelos de voz local de Piper (~63 MB cada uno): se descargan, no se versionan.
data/piper_voices/
